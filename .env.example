# Copy to .env.local (never commit real values).
# ——— Browser (public) — safe to expose ONLY because RLS protects every table ———
VITE_SUPABASE_URL=
# Supabase "publishable" key (sb_publishable_...) or legacy anon key. NOT the service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public site origin, used for canonical URLs, sitemap and OpenGraph (no trailing slash).
VITE_SITE_URL=
# Where the Node API lives. Empty = same origin (/api/...). Dev server proxies /api to 127.0.0.1:8787.
VITE_API_BASE=

# ——— Server only (Node API / Vercel Functions). Never prefix with VITE_. Never commit. ———
SUPABASE_URL=
# Supabase "secret" key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=
# Random string (32+ chars) used to hash client fingerprints for rate limiting.
RATE_LIMIT_SALT=
# Comma-separated hosts allowed for server-side URL probing (e.g. kol-barama.co.il,ykr.org.il).
IMPORT_URL_ALLOWLIST=
