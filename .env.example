# Copy to .env.local (never commit real values).
# ——— Browser (public). The browser never receives DATABASE_URL or AUTH_SECRET. ———
# api = call the site API. Anything else (or unset) = demo mode.
VITE_DATA_MODE=
# Public site origin, used for canonical URLs, sitemap and OpenGraph (no trailing slash).
VITE_SITE_URL=
# Where the Node API lives. Empty = same origin (/api/...). Dev server proxies /api to 127.0.0.1:8787.
VITE_API_BASE=

# ——— Server only (Node API / Vercel Functions). Never prefix with VITE_. Never commit. ———
# Neon or local Postgres connection string. The serverless driver is used unless the host is local.
DATABASE_URL=
# Random string, at least 16 characters. Signs sessions and private media URLs.
AUTH_SECRET=
# Random string (32+ chars) used to hash client fingerprints for rate limiting.
RATE_LIMIT_SALT=
# Comma-separated hosts allowed for server-side URL probing (e.g. kol-barama.co.il,ykr.org.il).
IMPORT_URL_ALLOWLIST=
# Optional mail (Resend). Both must be set or outbound mail is skipped and logged.
RESEND_API_KEY=
MAIL_FROM=
# Comma-separated staff addresses for a new question and for an answer awaiting the rabbi.
NOTIFY_EMAILS=
# Optional Telegram staff notice. Both must be set or it is skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Cloudflare Turnstile. Unset = the check is off. The site key is public.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=
