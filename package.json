{
  "name": "or-hameir-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "env:check": "node scripts/env-check.ts",
    "dev": "vite",
    "api": "node --env-file-if-exists=.env.local server/node-server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test tests/*.test.ts",
    "seed": "node scripts/build-seed.ts && node scripts/seed-to-sql.ts",
    "build": "npm run typecheck && vite build && node scripts/prerender.ts",
    "preview": "vite preview",
    "verify:db:local": "sh scripts/verify-db-local.sh"
  },
  "dependencies": {
    "@fontsource/frank-ruhl-libre": "5.3.0",
    "@fontsource/heebo": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "motion": "12.43.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
