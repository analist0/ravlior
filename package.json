{
  "name": "or-hameir-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "env:check": "node scripts/env-check.ts",
    "dev": "vite",
    "api": "node --env-file-if-exists=.env.local server/node-server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test tests/*.test.ts",
    "seed": "node scripts/build-seed.ts && node scripts/seed-to-sql.ts",
    "build": "npm run typecheck && vite build && node --env-file-if-exists=.env.local scripts/prerender.ts",
    "preview": "vite preview",
    "verify:db:local": "sh scripts/verify-db-local.sh"
  },
  "dependencies": {
    "@fontsource/assistant": "5.3.0",
    "@fontsource/noto-serif-hebrew": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "motion": "12.43.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uqr": "0.1.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
