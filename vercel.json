{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...route]" },
    { "source": "/sitemap.xml", "destination": "/api/seo/sitemap" },
    { "source": "/sitemap-:group.xml", "destination": "/api/seo/sitemap/:group" },
    { "source": "/robots.txt", "destination": "/api/seo/robots" },
    { "source": "/indexnow-key.txt", "destination": "/api/seo/indexnow-key" },
    { "source": "/item/:slug", "destination": "/api/seo/page?path=/item/:slug" },
    { "source": "/responsa/:slug", "destination": "/api/seo/page?path=/responsa/:slug" },
    { "source": "/topics/:slug", "destination": "/api/seo/page?path=/topics/:slug" },
    { "source": "/series/:slug", "destination": "/api/seo/page?path=/series/:slug" },
    { "source": "/p/:slug", "destination": "/api/seo/page?path=/p/:slug" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com; media-src 'self' blob: https:; font-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    { "source": "/admin(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/track(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
